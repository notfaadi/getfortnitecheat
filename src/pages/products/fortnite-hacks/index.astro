---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { productHub, productPages } from '../../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import { productPath } from '../../../utils/path';
import FaqSection from '../../../components/FaqSection.astro';
import ProductHubToolsCard from '../../../components/product/ProductHubToolsCard.astro';
import ProductHubExploreCard from '../../../components/product/ProductHubExploreCard.astro';
import ProductHubCloudDmaSection from '../../../components/product/ProductHubCloudDmaSection.astro';
import {
  productHubFaqs,
  PRODUCT_FAQ_FILTER_TOPICS,
  PRODUCT_FAQ_TOPIC_LABELS,
} from '../../../data/productFaqs';
import { faqPageSchema } from '../../../utils/schema';
import type { SiteFaqItem } from '../../../data/faq';

const seo = resolvePageSeo('/products/fortnite-hacks/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
    faqPageSchema(
      productHubFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a,
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.products.title}</h1>
        <p class="text-lg text-muted-foreground">{t.products.subtitle}</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {productPages.map((product) => (
          <CatalogCard
            label={cardLabel(product)}
            title={product.title}
            href={productPath(product.slug)}
            buyUrl={product.buyUrl}
            features={product.features}
            more={product.more}
            icon={cardIcon(product)}
            badge={product.badge}
            variant={product.variant}
            buyLabel="Buy now"
            viewLabel="View details"
          />
        ))}
      </div>

      <ProductHubCloudDmaSection />
    </div>
  </section>

  <FaqSection
    id="product-faq"
    class="product-hub-faq border-t border-border bg-muted/15"
    eyebrow="FAQ"
    title="Fortnite product FAQ"
    subtitle="Fortnite Cloud DMA, Fortnite HWID Spoofer, Fortnite Unlock All, and UGC."
    titleId="product-faq-heading"
    items={productHubFaqs as unknown as SiteFaqItem[]}
    showFilters
    filterTopics={[...PRODUCT_FAQ_FILTER_TOPICS]}
    topicLabels={PRODUCT_FAQ_TOPIC_LABELS}
    showIndex
    contentAlign="left"
  />

  <section class="border-t border-border py-12 md:py-16">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5">
      <ProductHubToolsCard />
      <ProductHubExploreCard />
    </div>
  </section>
</BaseLayout>
